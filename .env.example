# Copy to .env for local runs. On Render, set these in the dashboard instead. Never commit the real file.

# REQUIRED. A long random secret (16+ characters). The CAT tool sends it as "Authorization: Bearer <token>".
API_TOKEN=

# Sites allowed to call this API from a browser, comma separated. '*' is not accepted.
# '*' inside an address works as a wildcard for subdomains, e.g. https://*.lovable.app
ALLOWED_ORIGINS=https://your-site.example.com
# Lets pages on http://localhost:<port> call it too (handy while developing).
ALLOW_LOCALHOST=true

# --- Engine 1: Google Gemini (LLM) -------------------------------------------
# Single API key — no account rotation. Get one from https://aistudio.google.com/app/apikey
# Security: keep this secret. Never commit it.
GEMINI_API_KEY=

# Ordered model cascade inside the Gemini engine. On failure each model tries the next.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemma-4-26b-a4b-it

# --- Engine 2: Cloudflare Workers AI -----------------------------------------
# Create an API token at https://dash.cloudflare.com/profile/api-tokens
# with "Workers AI:Run" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Model to use. @cf/meta/m2m100-1.2b supports 100+ languages natively.
CLOUDFLARE_MODEL=@cf/meta/m2m100-1.2b

# --- Engine 3: MyMemory (free, final fallback) --------------------------------
# Optional but recommended: providing an email lifts the daily free quota
# from 5,000 to 50,000 characters per day.
MYMEMORY_EMAIL=

# --- Fallback chain & pacing --------------------------------------------------
# Order engines are tried in. Each result reports which one answered (via).
# google_web and google_gtx are available but disabled by default (web scrapers,
# easily blocked by Google).
ENGINE_ORDER=gemini,cloudflare,mymemory

# Pause between calls to the same engine (min-max seconds).
# Gemini needs 4-5 s to stay within free-tier rate limits.
# Cloudflare and MyMemory are much lighter.
ENGINE_DELAYS=gemini:4.0-5.0,cloudflare:0.5-1.0,mymemory:0.5-1.0

ENGINE_TIMEOUT_SECONDS=15
# Extra tries on the same engine after a network error, before moving to the next engine.
ENGINE_RETRIES=1
RETRY_BACKOFF_SECONDS=2

# An engine that fails this many times in a row is rested.
# A block page or HTTP 429 rests it at once (no threshold needed).
BREAKER_THRESHOLD=3
# Rest lengths in seconds: first trip, second trip, third and beyond. A success resets this.
COOLDOWN_STEPS=300,900,3600

# Remembered translations (lost on restart). 0 turns the cache off.
CACHE_SIZE=2000

# Request limits.
MAX_SEGMENTS=10
MAX_SEGMENT_CHARS=4500
MAX_REQUEST_CHARS=8000
# How long a request waits its turn, and how long one request may run before remainder is handed back.
QUEUE_WAIT_SECONDS=120
BATCH_DEADLINE_SECONDS=80
SELFTEST_MIN_INTERVAL_SECONDS=60

ENABLE_DOCS=false
LOG_LEVEL=INFO
